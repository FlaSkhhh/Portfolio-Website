/* ===== GLOBAL TYPOGRAPHY ===== */
* {
    -unity-font-definition: url('project://database/Assets/Resources/Inter-Regular.ttf'); 
}

.main-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: transparent; /* Changed from #0B0C10 */
    color: #FFFFFF;
}

/* Button Foundation Reset - Increased Sizes and locked flex-shrink */
Button {
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    min-height: 48px;
    height: 48px;
    padding-left: 24px;
    padding-right: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    white-space: nowrap;
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.15s;
}

.btn-primary {
    background-color: #0078D4;
    color: #FFFFFF;
}

.btn-primary:hover {
    background-color: #0088F0;
    scale: 1.02 1.02;
}

.btn-secondary {
    background-color: rgba(255, 255, 255, 0.06);
    color: #D1D5E0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border-color: #00E5FF;
}

/* Header */
.header-bar {
    height: 64px;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.header-nav {
    flex-direction: row;
    align-items: center;
}

.header-nav .nav-btn {
    margin-right: 12px;
}

.nav-btn {
    background-color: transparent;
    color: #C3C7D5;
    height: 40px;
    min-height: 40px;
    font-size: 15px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 6px;
}

.nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #00E5FF;
}

/* Content Area */
.content-area {
    flex-grow: 1;
    width: 100%;
}

.intro-view {
    width: 100%;
    min-height: 520px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
}

.intro-content {
    max-width: 760px;
    flex-direction: column;
    align-items: center;
}

.intro-headline {
    font-size: 48px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.intro-summary {
    font-size: 22px;
    color: #8E95A5;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.btn-enter {
    height: 52px;
    min-height: 52px;
    padding-left: 42px;
    padding-right: 42px;
    font-size: 17px;
    margin-top: 16px;
}

.portfolio-view {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    display: none;
    flex-direction: column;
    padding: 40px 24px;
}

.btn-back-home, .btn-back {
    margin-bottom: 32px;
    height: 44px;
    min-height: 44px;
    font-size: 26px; /* Bumps up the size of the arrow */
    padding-left: 28px;
    padding-right: 28px;
    -unity-font-style: bold;
}

.experience-section {
    margin-bottom: 36px;
}

.section-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 8px;
}

.section-subtitle {
    font-size: 17px;
    color: #8E95A5;
}

.project-scroll-view {
    width: 100%;
    flex-direction: column;
}

/* Gaming Shelf */
.gaming-shelf {
    width: 100%;
    margin-top: 48px;
    padding-top: 32px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.gaming-shelf-content {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.game-card {
    background-color: #14161F;
    color: #00E5FF;
    padding: 12px 20px;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    margin-right: 12px;
    margin-bottom: 12px;
}

/* Modal Overlay */
.project-detail-view {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.detail-overlay-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 6, 8, 0.85);
}

.detail-panel {
    width: 90%;
    max-width: 900px;
    max-height: 85%;
    background-color: #14161F;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.3);
    border-radius: 16px;
    padding: 40px;
    overflow: hidden;
}

.detail-image {
    width: 100%;
    height: 380px;
    background-color: #0B0C10;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-and-crop;
}

.detail-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 8px;
}

.detail-tags {
    margin-bottom: 20px;
}

.detail-tag-list {
    font-size: 15px;
    color: #00E5FF;
    -unity-font-style: bold;
}

.detail-description {
    font-size: 17px;
    color: #C3C7D5;
    white-space: normal;
    margin-bottom: 32px;
}

.detail-footer {
    flex-direction: row;
    align-items: center;
}

.detail-footer Button {
    margin-right: 16px;
}

/* ===== PORTRAIT / MOBILE OVERRIDES ===== */
@media (max-width: 1400px) {
    .header-bar,
    .intro-content,
    .portfolio-view,
    .experience-section,
    .detail-panel {
        width: 100%;
        align-items: stretch;
    }

    .header-bar {
        padding-left: 16px;
        padding-right: 16px;
    }

    .intro-headline {
        font-size: 48px;
        width: 100%;
    }

    .intro-summary {
        font-size: 19px;
        width: 100%;
    }

    .section-title {
        font-size: 32px;
    }

    .portfolio-view {
        padding: 24px 16px;
    }

    .detail-panel {
        width: 95%;
        padding: 24px 16px;
        max-height: 90%;
    }

    .detail-title {
        font-size: 30px;
    }

    .detail-description {
        font-size: 16px;
    }

    .nav-btn {
        padding-left: 10px;
        padding-right: 10px;
    }
}
/* ===== RETRO LOADING SCREEN ===== */
.loading-screen {
    width: 100%;
    height: 120px;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.retro-container {
    width: 300px;
    flex-direction: column;
    align-items: center;
}

.retro-text {
    color: #FFDE00; /* Arcade Yellow */
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 24px;
}

.retro-track {
    width: 100%;
    height: 32px;
    border-bottom-width: 4px;
    border-bottom-color: #1919A6; /* Arcade Maze Blue */
    position: relative;
    justify-content: center;
}

.retro-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: #FFAAAA;
    border-radius: 3px;
    top: 13px; /* Center in the track */
}

.retro-character {
    position: absolute;
    width: 24px;
    height: 24px;
    background-color: #FFDE00;
    border-radius: 12px; /* Makes it a perfect circle */
    top: 4px;
    left: 0%;
    transition-property: left;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
}

/* ===== PROJECT DETAIL MODAL ===== */
.project-detail-view {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
}

.detail-overlay-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(5, 6, 10, 0.82);
}

.detail-panel {
    width: 85%;
    max-width: 900px;
    height: 85%;
    max-height: 750px;
    background-color: #12141C;
    border-color: rgba(255, 255, 255, 0.12);
    border-width: 1px;
    border-radius: 12px;
    padding: 24px;
    flex-direction: column;
}

.detail-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding-bottom: 12px;
}

.btn-detail-back {
    height: 38px;
    font-size: 22px;
    padding: 0 16px;
    margin-right: 16px;
    -unity-font-style: bold;
}

.detail-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    flex-grow: 1;
}

.detail-scroll-area {
    flex-grow: 1;
    margin-bottom: 16px;
    padding-right: 8px;
}

.detail-image {
    width: 100%;
    height: 340px;
    border-radius: 8px;
    background-color: #0E1017;
    -unity-background-scale-mode: scale-and-crop;
    margin-bottom: 20px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.detail-meta-header {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #00E5FF;
    margin-top: 12px;
    margin-bottom: 8px;
}

.detail-tag-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.detail-description {
    font-size: 15px;
    color: #C0C5D0;
    white-space: normal;
    margin-bottom: 24px;
}

.detail-footer {
    flex-direction: row;
    justify-content: flex-end;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    margin-left: 12px;
    padding-top: 16px;
}

.scroll-chevron {
    position: absolute;
    bottom: 40px; 
    left: 0;
    right: 0; 
    -unity-text-align: middle-center;
    font-size: 32px;
    color: #00E5FF;
    -unity-font-style: bold;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
}

.scroll-chevron--hidden {
    opacity: 0;
    translate: 0 10px;
}