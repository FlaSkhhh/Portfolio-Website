<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI%20Toolkit%20Scripts/MainPortfolioLayout.uss?fileID=7433441132597879392&amp;guid=2e4354352d70aa8469aab964a493cbc6&amp;type=3#MainPortfolioLayout"/>
    <ui:VisualElement class="main-container">
        <ui:VisualElement class="header-bar">
            <ui:VisualElement class="header-side header-side--left">
                <ui:VisualElement class="portal portal--vertical-header"/>
                <ui:Label name="HeaderName" text="SHANTANU NANDKHILE" class="header-title header-teleport-item header-teleport-item--hidden"/>
            </ui:VisualElement>
            <ui:VisualElement name="HeaderNav" class="header-side header-side--right">
                <ui:Button name="HeaderExploreBtn" class="cyber-btn primary header-teleport-item header-teleport-item--hidden">
                    <ui:VisualElement class="cyber-shadow"/>
                    <ui:VisualElement class="cyber-body"/>
                    <ui:Label text="PROJECTS" class="cyber-text"/>
                </ui:Button>
                <ui:Button name="NavContact" class="cyber-btn secondary">
                    <ui:VisualElement class="cyber-shadow"/>
                    <ui:VisualElement class="cyber-body"/>
                    <ui:Label text="CONTACT" class="cyber-text"/>
                </ui:Button>
                <ui:Button name="BtnDownloadCV" class="cyber-btn secondary">
                    <ui:VisualElement class="cyber-shadow"/>
                    <ui:VisualElement class="cyber-body"/>
                    <ui:Label text="RESUME" class="cyber-text"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
              
        <ui:VisualElement name="PortfolioHeaderRow" class="portfolio-header-row" style="display: none;">
            <ui:Button name="BtnBackToHome" text="←" class="btn-back btn-detail-back"/>
        </ui:VisualElement>

        <ui:ScrollView name="MainScrollArea" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden" class="content-area">
            <ui:VisualElement name="IntroView" class="intro-view">
                <ui:VisualElement picking-mode="Ignore" class="hero-portal-container">
                    <ui:VisualElement name="HeroPortal" picking-mode="Ignore" class="portal portal--horizontal-hero"/>
                        <ui:Label text="HELLO THERE &#10;I&apos;M SHANTANU" name="HeroTitle" class="hero-title"/>
                        <ui:Label text="Generalist Game Programmer" name="HeroSubtitle" class="hero-subtitle"/>
                        <ui:Button name="BtnEnter" class="cyber-btn primary" style="margin-top: 32px; align-self: center; flex-direction: row;">
                        <ui:VisualElement class="cyber-shadow"/>
                        <ui:VisualElement class="cyber-body"/>
                        <ui:Label text="PROJECTS" class="cyber-header"/>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement name="AboutSection" class="about-section">
                    <ui:Label text="ABOUT ME" class="section-title"/>
                    <ui:VisualElement class="about-content-container">
                        <ui:VisualElement class="about-top-row">
                            <ui:VisualElement name="ProfileImage" class="profile-image-circle"/>
                            <ui:Label name="AboutParagraphTop" text="Loading..." class="about-paragraph about-paragraph--top"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="about-bottom-area">
                            <ui:Label name="AboutParagraphBottom" text="Loading..." class="about-paragraph about-paragraph--bottom"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="MainPortfolioView" class="portfolio-view">

                <ui:VisualElement class="experience-section">
                    <ui:Label text="Featured Projects" class="section-title"/>
                    <ui:Label text="A selection of core engineering work in multiplayer architecture, shaders, and AI systems." class="section-subtitle"/>
                </ui:VisualElement>
                <ui:VisualElement name="LoadingScreen" class="loading-screen">
                    <ui:VisualElement class="retro-container">
                        <ui:VisualElement name="CyberSpinner" class="cyber-spinner"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ProjectScrollView" class="project-scroll-view"/>
                
                <ui:VisualElement name="GamingShelfView" class="gaming-shelf">
                    <ui:Label text="Competitive Shelf" class="section-title"/>
                    <ui:VisualElement class="gaming-shelf-content">
                        <ui:Label text="Clash Royale" class="game-card"/>
                        <ui:Label text="Counter-Strike 2" class="game-card"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:Label name="ScrollChevron" picking-mode="Ignore" class="scroll-chevron"/>
        <ui:VisualElement name="ProjectDetailView" class="project-detail-view" style="display: none;">
            <ui:VisualElement class="detail-panel">
                <ui:VisualElement class="detail-header-row">
                    <ui:Button name="BtnBack" text="←" class="btn-back btn-detail-back"/>
                    <ui:Label name="DetailTitle" text="Project Title" class="detail-title"/>
                </ui:VisualElement>
                <ui:ScrollView name="DetailScrollArea" class="detail-scroll-area">
                    <ui:VisualElement name="DetailImage" class="detail-image"/>
                    <ui:VisualElement class="detail-meta">
                        <ui:Label text="TECH STACK" class="detail-meta-header"/>
                        <ui:VisualElement name="DetailTagsContainer" class="detail-tag-container"/>
                        <ui:VisualElement class="detail-action-row" style="flex-direction: row;">
                            <ui:Button name="BtnDetailGitHub" class="cyber-btn tertiary">
                                <ui:VisualElement class="cyber-shadow"/>
                                <ui:VisualElement class="cyber-body"/>
                                <ui:Label text="GITHUB REPO" class="cyber-text"/>
                            </ui:Button>
                            <ui:Button name="BtnDetailDemo" class="cyber-btn quaternary">
                                <ui:VisualElement class="cyber-shadow"/>
                                <ui:VisualElement class="cyber-body"/>
                                <ui:Label text="LIVE DEMO" class="cyber-text"/>
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="DetailDynamicContent" class="detail-dynamic-content"/>
                    <ui:Label text="OVERVIEW &amp; ARCHITECTURE" class="detail-meta-header"/>
                    <ui:Label name="DetailDescription" text="Full breakdown..." class="detail-description"/>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="ContactModalOverlay" class="modal-overlay modal-overlay--hidden">
        <ui:VisualElement name="ContactModalBox" class="modal-box">
            <ui:Button name="BtnCloseModal" text="←" class="btn-back btn-modal-back" />
            <ui:Label text="CONTACTS" class="section-title" style="margin-bottom: 16px; font-size: 28px;" />
            <ui:Label text="YOUR NAME HERE" class="contact-name" />
            <ui:Label text="+1 (555) 123-4567" class="contact-phone" />
            <ui:VisualElement class="contact-btn-row">
                <ui:Button name="BtnContactGitHub" class="cyber-btn primary">
                    <ui:VisualElement class="cyber-shadow"/>
                    <ui:VisualElement class="cyber-body"/>
                    <ui:Label text="GITHUB" class="cyber-text"/>
                </ui:Button>
            
                <ui:Button name="BtnContactLinkedIn" class="cyber-btn secondary">
                    <ui:VisualElement class="cyber-shadow"/>
                    <ui:VisualElement class="cyber-body"/>
                    <ui:Label text="LINKEDIN" class="cyber-text"/>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="SwipeIndicatorBack" class="swipe-indicator swipe-indicator--back">
        <ui:VisualElement class="chev-scaler pos-3">
            <ui:VisualElement class="chev-shape chev-left chev-outline color-cyan"/>
        </ui:VisualElement>
        <ui:VisualElement class="chev-scaler pos-2">
            <ui:VisualElement class="chev-shape chev-left chev-solid color-cyan"/>
        </ui:VisualElement>
        <ui:VisualElement class="chev-scaler pos-1">
            <ui:VisualElement class="chev-shape chev-left chev-solid color-magenta"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="SwipeIndicatorForward" class="swipe-indicator swipe-indicator--forward">
        <ui:VisualElement class="chev-scaler pos-3">
            <ui:VisualElement class="chev-shape chev-right chev-outline color-cyan"/>
        </ui:VisualElement>
        <ui:VisualElement class="chev-scaler pos-2">
            <ui:VisualElement class="chev-shape chev-right chev-solid color-cyan"/>
        </ui:VisualElement>
        <ui:VisualElement class="chev-scaler pos-1">
            <ui:VisualElement class="chev-shape chev-right chev-solid color-magenta"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
