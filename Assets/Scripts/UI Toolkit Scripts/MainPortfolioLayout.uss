/* ===== GLOBAL TYPOGRAPHY ===== */
* {
    -unity-font-definition: url('project://database/Assets/Resources/Inter-Regular.ttf');
}
/* Cyberpunk display font for Headers, Buttons, and Retro text */
.cyber-text,
.header-title,
.section-title,
.detail-title,
.detail-meta-header,
.intro-headline,
.retro-text {
    -unity-font-definition: url('project://database/Assets/Resources/Orbitron-Regular.ttf');
}
Scroller {
    display: none;
}
.is-mobile .intro-headline {
    font-size: 36px; /* Reduced from 48px */
    width: 100%;
}

.main-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: transparent; 
    color: #FFFFFF;
}

/* ===== BASE BUTTON RESET ===== */
Button {
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-radius: 8px; /* Kept for standard UI buttons, overridden for Cyber buttons */
    min-height: 48px;
    height: 48px;
    padding-left: 24px;
    padding-right: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    white-space: nowrap;
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.15s;
}

/* ===== CYBERPUNK ACTION BUTTONS (Sprite-Based) ===== */
.cyber-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: 0; /* Prevents Unity from clipping the sharp PNG corners */
    min-width: 240px;
    height: 52px;
    margin-right: 24px;
    margin-top: 16px;
    justify-content: center;
    align-items: center;
}

.cyber-shadow, 
.cyber-body {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    
    background-image: url('project://database/Assets/Resources/CP_Button_White.png');
    
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.cyber-shadow {
    translate: 6px 0; 
}

.cyber-text {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #000000;
}
.cyber-header {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: -5px;
    color: #000000;
}

.cyber-tag {
    position: absolute;
    bottom: -2px;
    right: 18px; 
    font-size: 9px;
    -unity-font-style: bold;
    color: #000000;
}
.tag-cyan { color: #55ead4; }

/* ==========================================
   CYBERPUNK BUTTON COLOR PRESETS
========================================== */

/* 1. PRIMARY: Yellow Body / Cyan Accent / Black Text */
.cyber-btn.primary .cyber-body { -unity-background-image-tint-color: #f3e600; }
.cyber-btn.primary .cyber-shadow { -unity-background-image-tint-color: #55ead4; }
.cyber-btn.primary .cyber-text { color: #000000; }
.cyber-btn.primary:hover .cyber-body { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.primary:hover .cyber-shadow { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.primary:hover .cyber-text { color: #f3e600; text-shadow: 0 0 10px rgba(243, 230, 0, 0.8); }

/* 2. SECONDARY: Dark Red Body / Bright Red Accent / Cyan Text */
.cyber-btn.secondary .cyber-body { -unity-background-image-tint-color: #880425; } 
.cyber-btn.secondary .cyber-shadow { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.secondary .cyber-text { color: #55ead4; } 
.cyber-btn.secondary:hover .cyber-body { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.secondary:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.secondary:hover .cyber-text { color: #000000; }

/* 3. TERTIARY (The 3-Color Special): Bright Red Body / Yellow Accent / Cyan Text */
.cyber-btn.tertiary .cyber-body { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.tertiary .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.tertiary .cyber-text { color: #55ead4; } 
.cyber-btn.tertiary .cyber-tag { color: #000000; }
.cyber-btn.tertiary:hover .cyber-body { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.tertiary:hover .cyber-shadow { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.tertiary:hover .cyber-text { color: #c5003c; text-shadow: 0 0 10px rgba(197, 0, 60, 0.8); }

/* 4. QUATERNARY: Hot Pink / Neon Green / Black Text */
.cyber-btn.quaternary .cyber-body { -unity-background-image-tint-color: #FF007C; } 
.cyber-btn.quaternary .cyber-shadow { -unity-background-image-tint-color: #00FF9D; } 
.cyber-btn.quaternary .cyber-text { color: #000000; } 
.cyber-btn.quaternary:hover .cyber-body { -unity-background-image-tint-color: #00FF9D; } 
.cyber-btn.quaternary:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.quaternary:hover .cyber-text { color: #FF007C; text-shadow: 0 0 10px rgba(255, 0, 124, 0.8); }

/* 5. GHOST / HACKER: Black Body / Cyan Accent / Yellow Text */
.cyber-btn.ghost .cyber-body { -unity-background-image-tint-color: rgba(11, 12, 16, 0.95); } 
.cyber-btn.ghost .cyber-shadow { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.ghost .cyber-text { color: #f3e600; } 
.cyber-btn.ghost .cyber-tag { color: #FF007C; }
.cyber-btn.ghost:hover .cyber-body { -unity-background-image-tint-color: rgba(85, 234, 212, 0.2); } 
.cyber-btn.ghost:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.ghost:hover .cyber-text { color: #55ead4; text-shadow: 0 0 10px rgba(85, 234, 212, 0.8); }

/* ===== SOLID NEON SQUARE BACK BUTTONS ===== */
.btn-back {
    background-color: #55ead4; /* Solid Cyan */
    color: #000000; /* Black Text */
    border-width: 0;
    border-radius: 0; /* Sharp Square */
    
    border-left-width: 6px;
    border-left-color: #c5003c; /* Red left accent */
    
    height: 44px;
    padding-left: 20px;
    padding-right: 24px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
}

.btn-back:hover {
    background-color: #f3e600; /* Swaps to Yellow */
    color: #000000;
    border-left-color: #55ead4; /* Swaps accent to Cyan */
    scale: 1.05 1.05;
}

.btn-back-home { margin-bottom: 32px; font-size: 26px; }
.btn-detail-back { font-size: 24px; margin-right: 16px; height: 40px; }

/* ===== HEADER ===== */
.header-bar {
    height: 64px;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.header-nav {
    flex-direction: row;
    align-items: center;
}

.header-nav .nav-btn {
    margin-right: 12px;
}

.nav-btn {
    background-color: transparent;
    color: #C3C7D5;
    height: 40px;
    min-height: 40px;
    font-size: 15px;
    padding-left: 18px;
    padding-right: 18px;
    border-radius: 6px;
}

.nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #00E5FF;
}

/* ===== CONTENT AREA ===== */
.content-area {
    flex-grow: 1;
    width: 100%;
}

.intro-view {
    width: 100%;
    flex-direction: column;
    align-items: center;
    /* Pushes content from the top down so scrolling works naturally */
    justify-content: flex-start; 
    padding: 0; 
}

.intro-content {
    max-width: 760px;
    flex-direction: column;
    align-items: center;
}

.intro-headline {
    font-size: 48px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.intro-summary {
    font-size: 22px;
    color: #8E95A5;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.about-section {
    width: 100%;
    max-width: 800px;
    align-items: center;
    padding-top: 100px;
    padding-bottom: 200px; 
}

.portfolio-view {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    display: none;
    flex-direction: column;
    padding: 40px 24px;
}

.experience-section {
    margin-bottom: 36px;
}

.section-title {
    font-size: 36px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin-bottom: 8px;
}

.section-subtitle {
    font-size: 17px;
    color: #8E95A5;
}

.project-scroll-view {
    width: 100%;
    flex-direction: column;
}

/* ===== GAMING SHELF ===== */
.gaming-shelf {
    width: 100%;
    margin-top: 48px;
    padding-top: 32px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.gaming-shelf-content {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 16px;
}

.game-card {
    background-color: #14161F;
    color: #00E5FF;
    padding: 12px 20px;
    font-size: 14px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
    margin-right: 12px;
    margin-bottom: 12px;
}

/* ===== FULL PAGE CASE STUDY ===== */
.project-detail-view {
    width: 100%;
    flex-grow: 1; 
    background-color: transparent;
}

.detail-panel {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    flex-direction: column;
}

.detail-header-row {
    flex-direction: row;
    align-items: center;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding: 12px 32px;
}

.detail-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    flex-grow: 1;
}

.detail-scroll-area {
    flex-grow: 1;
    width: 100%;
}

.detail-image {
    width: 100%;
    max-width: 1000px; 
    align-self: center; 
    height: 450px; 
    min-height: 300px;
    max-height: 600px;
    background-color: #0B0C10;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-top: 32px; 
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit; 
}

.detail-meta,
.detail-meta-header,
.detail-description,
.detail-dynamic-content,
.detail-footer {
    width: 100%;
    max-width: 900px;
    align-self: center; 
    padding-left: 24px;
    padding-right: 24px;
}

.detail-meta-header {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #00E5FF;
    margin-top: 16px;
    margin-bottom: 12px;
}

.detail-tag-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 32px;
}

.detail-description {
    font-size: 17px;
    color: #C0C5D0;
    white-space: normal;
    margin-bottom: 48px; 
}

.detail-footer {
    flex-direction: row;
    justify-content: flex-start; 
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 32px;
    padding-bottom: 100px; 
}

.detail-footer Button {
    margin-right: 16px;
}
/* ===== ALTERNATING ZIGZAG CASE STUDY ROWS ===== */
.detail-dynamic-row {
    flex-direction: row;
    width: 100%;
    align-items: center; /* Vertically centers the text alongside the image */
    margin-bottom: 56px; /* Heavy breathing room between sections */
}

/* Instantly flips the flexbox layout so Image is Left and Text is Right */
.detail-dynamic-row--reverse {
    flex-direction: row-reverse;
}
.detail-dynamic-row--reverse .detail-dynamic-text {
    padding-left: 0;
    padding-right: 40px; 
}

.detail-dynamic-image {
    width: 50%; /* Uses safe percentage scaling instead of hard pixels */
    max-width: 450px; 
    height: 300px; 
    flex-shrink: 0; /* Prevents the image from being squished by long text */
    
    background-color: transparent; 
    border-width: 0; 
    
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
    align-items: center;
}

.detail-dynamic-text {
    flex-grow: 1;
    flex-shrink: 1; /* Allows the text box to compress dynamically */
    font-size: 17px;
    color: #C0C5D0;
    white-space: normal;
    padding-left: 40px; 
}

/* Kicks in dynamically via C# when there is no image on the row */
.detail-dynamic-text--full {
    width: 100%;
    padding-left: 0;
    padding-right: 0;
}

.detail-dynamic-row--reverse .detail-dynamic-text {
    padding-left: 0;
    padding-right: 40px; 
}

/* ===== CP LOADING SCREEN ===== */
.loading-screen {
    width: 100%;
    height: 120px;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.retro-container {
    width: 300px;
    flex-direction: column;
    align-items: center;
}

.retro-text {
    color: #FFDE00; 
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 24px;
}

.cyber-spinner {
    width: 64px;
    height: 64px;
    border-width: 4px;
    border-radius: 50%; /* Creates a perfect circle */
    
    /* Creates a dashed neon ring effect */
    border-color: rgba(85, 234, 212, 0.1); 
    border-top-color: #55ead4; 
    border-right-color: #FF007C; 
}

/* ===== CSS-ONLY SOLID TRIANGLE CHEVRON ===== */
.scroll-chevron {
    position: absolute;
    bottom: 32px; 
    align-self: center;
    
    width: 0;
    height: 0;
    background-color: transparent;
    
    border-left-width: 16px;
    border-right-width: 16px;
    border-top-width: 20px;
    border-bottom-width: 0;
    
    border-left-color: rgba(0,0,0,0);
    border-right-color: rgba(0,0,0,0);
    border-top-color: #f3e600; 
    
    transition-property: opacity, translate;
    transition-duration: 0.3s;
}

.scroll-chevron--hidden {
    opacity: 0;
    translate: 0 10px;
}

/* ===== SKELETON LOADER ===== */
.skeleton-loader {
    background-color: rgba(0, 0, 0, 0.6);
    border-color: rgba(243, 230, 0, 0.3); 
    border-width: 2px;
    border-radius: 12px; 
    justify-content: center;
    align-items: center;
}

.skeleton-text {
    color: #f3e600; 
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}
