.main-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: #0B0C10;
    color: #FFFFFF;
}

/* Button Foundation Reset */
Button {
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
    cursor: link;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    min-height: 44px;
    height: 44px;
    padding-left: 20px;
    padding-right: 20px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.15s;
}

.btn-primary {
    background-color: #0078D4;
    color: #FFFFFF;
}

.btn-primary:hover {
    background-color: #0088F0;
    scale: 1.02 1.02;
}

.btn-secondary {
    background-color: rgba(255, 255, 255, 0.06);
    color: #D1D5E0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border-color: #00E5FF;
}

/* Header */
.header-bar {
    height: 64px;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.header-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.header-nav {
    flex-direction: row;
    align-items: center;
    gap: 12px;
}

.nav-btn {
    background-color: transparent;
    color: #C3C7D5;
    height: 38px;
    min-height: 38px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 6px;
}

.nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #00E5FF;
}

/* Content Area */
.content-area {
    flex-grow: 1;
    width: 100%;
}

.intro-view {
    width: 100%;
    min-height: 520px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
}

.intro-content {
    max-width: 720px;
    flex-direction: column;
    gap: 20px;
    align-items: center;
}

.intro-headline {
    font-size: 40px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    -unity-text-align: middle-center;
}

.intro-summary {
    font-size: 16px;
    color: #8E95A5;
    white-space: normal;
    -unity-text-align: middle-center;
    line-height: 24px;
}

.btn-enter {
    height: 48px;
    min-height: 48px;
    padding-left: 36px;
    padding-right: 36px;
    font-size: 15px;
    margin-top: 12px;
}

.portfolio-view {
    width: 100%;
    max-width: 1200px;
    align-self: center;
    display: none;
    flex-direction: column;
    padding: 40px 24px;
}

.experience-section {
    margin-bottom: 36px;
    gap: 8px;
}

.section-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.section-subtitle {
    font-size: 15px;
    color: #8E95A5;
}

.project-scroll-view {
    width: 100%;
    flex-direction: column;
}

/* Gaming Shelf */
.gaming-shelf {
    width: 100%;
    margin-top: 48px;
    padding-top: 32px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.gaming-shelf-content {
    flex-direction: row;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 16px;
}

.game-card {
    background-color: #14161F;
    color: #00E5FF;
    padding: 10px 18px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 6px;
}

/* Modal Overlay */
.project-detail-view {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.detail-overlay-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(5, 6, 8, 0.85);
}

.detail-panel {
    width: 90%;
    max-width: 900px;
    max-height: 85%;
    background-color: #14161F;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.3);
    border-radius: 16px;
    padding: 36px;
    overflow-y: auto;
}

.btn-back {
    margin-bottom: 24px;
    height: 38px;
    min-height: 38px;
    padding-left: 16px;
    padding-right: 16px;
}

.detail-image {
    width: 100%;
    height: 340px;
    background-color: #0B0C10;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 24px;
    -unity-background-scale-mode: scale-and-crop;
}

.detail-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 8px;
}

.detail-tags {
    margin-bottom: 18px;
}

.detail-tag-list {
    font-size: 13px;
    color: #00E5FF;
    -unity-font-style: bold;
}

.detail-description {
    font-size: 15px;
    color: #C3C7D5;
    white-space: normal;
    line-height: 24px;
    margin-bottom: 28px;
}

.detail-footer {
    flex-direction: row;
    gap: 16px;
    align-items: center;
}