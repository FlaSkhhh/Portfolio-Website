Scroller {
    display: none;
}
.showcase-row {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    flex-direction: row;
    min-height: 380px;
    max-height: 480px;
    margin-bottom: 56px; /* Increased breathing room since the box is gone */
    
    /* STRIPPED OUT THE BOX */
    padding: 0; 
    background-color: rgba(20, 20, 20, 0.4); 
    border-width: 0;
    
    align-items: stretch;
    overflow: hidden;
    
    transition-property: border-color, translate, opacity;
    transition-duration: 0.2s, 0.6s, 0.8s;
    transition-timing-function: ease-out-back, ease-out;
}

/* CSS States toggled by the C# ScrollAnimationController */
.showcase-row--hidden {
    opacity: 0;
    translate: 0 60px 0;
}

.showcase-row--visible {
    opacity: 1;
    translate: 0 0 0;
}

.showcase-row.showcase-row--visible:hover {
    translate: 0 -4px 0;
    border-color: #00E5FF;
    transition-delay: 0.4s, 0.4s, 0s; 
}

.showcase-row--reverse {
    flex-direction: row-reverse;
}

.showcase-column {
    flex-direction: column;
    justify-content: center;
}

.showcase-column--image {
    /* Dynamic sizing instead of strict percentages */
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 400px; /* Ideal starting width */
    max-width: 650px;  /* Stops the image from getting too massive */
    
    padding-left: 5px;
    padding-right: 32px; /* Creates a strict 32px gap between image and text */
}

.showcase-column--info {
    /* Forces the text to dynamically fill whatever space the image leaves behind */
    flex-grow: 2; 
    
    padding-left: 5px;
    padding-right: 5px;
}

/* Flips the 32px gap to the left side when the layout alternates */
.showcase-row--reverse .showcase-column--image {
    padding-right: 5px;
    padding-left: 32px; 
}

.project-image {
    width: 100%;
    height: 100%;
    
    /* Transparent dark background */
    background-color: rgba(11, 12, 16, 0.4); 
    
    /* Top and Bottom lines only */
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-right-width: 0;
    
    /* Faded Cyan border */
    border-color: rgba(85, 234, 212, 0.2); 
    border-radius: 0;
    
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;

    transition-property: border-color;
    transition-duration: 0.3s;
}

.platform-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(11, 12, 16, 0.9);
    color: #00E5FF;
    border-color: rgba(0, 229, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
}
.showcase-row--reverse .platform-badge {
    right: auto;
    left: 16px; /* Moves the badge to the left of the image */
}

.tag-container {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.showcase-row--reverse .tag-container {
    justify-content: flex-end; /* Pushes the tech pills to the right */
}

.tech-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 4px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.project-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 14px;
}

.project-description {
    font-size: 16px;
    color: #8E95A5;
    white-space: normal;
    margin-bottom: 20px;
}
.showcase-row--reverse .project-title,
.showcase-row--reverse .project-description {
    -unity-text-align: upper-right; /* Anchors text to the right */
}

.button-row {
    flex-direction: row;
    align-items: center;
}
.showcase-row--reverse .button-row {
    justify-content: flex-end; /* Pushes buttons to the right */
}

.button-row Button {
    margin-right: 12px;
    flex-shrink: 0;
    white-space: nowrap;
}
.showcase-row--reverse .button-row Button {
    margin-right: 0;
    margin-left: 12px; /* Flips the button spacing */
}
/* ===== RESPONSIVE PORTRAIT QUERY ===== */
@media (max-width: 1400px) {
    .showcase-row {
        flex-direction: column;
        width: 100%;
        min-height: auto;
        max-height: none; /* CRITICAL: Allows vertical stacking without chopping off text */
        padding: 20px;
        margin-bottom: 28px;
        align-items: stretch;
    }

    .showcase-row--reverse {
        flex-direction: column;
    }

    .showcase-column--image {
        width: 100%;
        max-width: none; /* Reset ceiling */
        min-height: 60vw; /* Scales the image naturally with phone width */
        height: 60vw;
        max-height: none; /* Reset ceiling */
        margin-bottom: 24px;
        padding-left: 0;
        padding-right: 0;
        flex-shrink: 0;
    }

    .project-image {
        width: 100%;
        height: 100%;
        min-height: 60vw;
        max-height: none; /* Reset ceiling */
    }

    .showcase-column--info {
        width: 100%;
        max-width: none; /* Reset ceiling */
        padding-left: 0;
        padding-right: 0;
    }

    .project-title {
        font-size: 28px;
        width: 100%;
    }

    .project-description {
        font-size: 17px;
        width: 100%;
    }

    .button-row {
        flex-direction: column;
        width: 100%;
    }

    .btn-primary,
    .btn-secondary {
        width: 100%;
        margin-right: 0;
        margin-bottom: 12px;
    }

    /* Reset reverse alignment back to normal for stacked mobile cards */
    .showcase-row--reverse .showcase-column--info {
        align-items: flex-start;
    }

    .showcase-row--reverse .project-title,
    .showcase-row--reverse .project-description {
        -unity-text-align: upper-left;
    }

    .showcase-row--reverse .tag-container,
    .showcase-row--reverse .button-row {
        justify-content: flex-start;
    }

    .showcase-row--reverse .button-row Button {
        margin-left: 0;
        margin-right: 12px;
    }
    
    .showcase-row--reverse .platform-badge {
        left: auto;
        right: 16px;
    }
}