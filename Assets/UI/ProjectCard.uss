.project-card {
    width: 380px;
    flex-direction: column;
    background-color: rgb(30, 30, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(50, 50, 50);
    border-right-color: rgb(50, 50, 50);
    border-top-color: rgb(50, 50, 50);
    border-bottom-color: rgb(50, 50, 50);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin-left: 12px;
    margin-right: 12px;
    margin-top: 12px;
    margin-bottom: 12px;
}

.card-image-container {
    width: 100%;
    height: 200px;
    background-color: rgb(42, 42, 42);
}

.card-tag {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgb(0, 120, 212);
    color: rgb(255, 255, 255);
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 12px;
    -unity-font-style: bold;
}

.card-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 16px;
    padding-bottom: 8px;
    white-space: normal;
}

.card-description {
    font-size: 13px;
    color: rgb(176, 176, 176);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 0;
    padding-bottom: 16px;
    white-space: normal;
    flex-grow: 1;
}

.btn-case-study {
    background-color: rgb(0, 120, 212);
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-left: 16px;
    margin-right: 16px;
    margin-top: 0;
    margin-bottom: 16px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(0, 120, 212);
    border-right-color: rgb(0, 120, 212);
    border-top-color: rgb(0, 120, 212);
    border-bottom-color: rgb(0, 120, 212);
}