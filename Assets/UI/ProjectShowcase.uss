.showcase-row {
    width: 100%;
    flex-direction: row;
    min-height: 380px;
    margin-bottom: 40px;
    padding: 28px;
    align-items: center;
    background-color: #14161F;
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 14px;
    overflow: hidden;
    transition-property: border-color, translate, opacity;
    transition-duration: 0.2s, 0.2s, 0.4s;
}

.showcase-row:hover {
    border-color: rgba(0, 229, 255, 0.5);
    translate: 0 -3px 0;
}

.showcase-row--reverse {
    flex-direction: row-reverse;
}

.showcase-column {
    flex-direction: column;
    justify-content: center;
}

.showcase-column--image {
    width: 52%;
    padding-left: 16px;
    padding-right: 16px;
}

.showcase-column--info {
    width: 48%;
    padding-left: 24px;
    padding-right: 24px;
}

.project-image {
    width: 100%;
    height: 320px;
    background-color: #0B0C10;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.platform-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(11, 12, 16, 0.9);
    color: #00E5FF;
    border-color: rgba(0, 229, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
}

.tag-container {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}

.tech-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 4px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.project-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 14px;
}

.project-description {
    font-size: 16px;
    color: #8E95A5;
    white-space: normal;
    margin-bottom: 20px;
}

.button-row {
    flex-direction: row;
    align-items: center;
}

.button-row Button {
    margin-right: 12px;
    flex-shrink: 0;
    white-space: nowrap;
}

/* ===== RESPONSIVE PORTRAIT QUERY ===== */
@media (max-width: 1400px) {
    .showcase-row {
        flex-direction: column;
        width: 100%;
        min-height: auto;
        padding: 20px;
        margin-bottom: 28px;
        align-items: stretch;
    }

    .showcase-row--reverse {
        flex-direction: column;
    }

    .showcase-column--image {
        width: 100%;
        min-height: 260px;
        height: 260px;
        margin-bottom: 20px;
        padding-left: 0;
        padding-right: 0;
        flex-shrink: 0;
    }

    .project-image {
        width: 100%;
        height: 100%;
        min-height: 260px;
    }

    .showcase-column--info {
        width: 100%;
        padding-left: 0;
        padding-right: 0;
    }

    .project-title {
        font-size: 28px;
        width: 100%;
    }

    .project-description {
        font-size: 17px;
        width: 100%;
    }

    .button-row {
        flex-direction: column;
        width: 100%;
    }

    .btn-primary,
    .btn-secondary {
        width: 100%;
        margin-right: 0;
        margin-bottom: 12px;
    }
}