/*
/* --- HOLOGRAPHIC HUD BRACKET --- */
/* --- THE INVISIBLE CONTAINER --- */
/* --- THE INVISIBLE CONTAINER --- */
/* ==========================================
   THE INVISIBLE CONTAINER
========================================== */
/* ==========================================
   THE INVISIBLE CONTAINER
========================================== */
/* ==========================================
   THE INVISIBLE CONTAINER
========================================== */
.swipe-indicator {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 140px;  
    height: 100px;  
    
    display: none; 
    opacity: 0;
    
    transition-property: translate, scale, opacity;
    transition-duration: 0.1s, 0.15s, 0.15s; 
    transition-timing-function: ease-out-bounce;
}

.swipe-indicator--back { left: -140px; }
.swipe-indicator--forward { right: -140px; }


/* ==========================================
   TRANSFORM SEPARATION (The Symmetry Fix!)
========================================== */

/* 1. The Wrapper: Handles positioning and global squashing */
.chev-scaler {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    
    width: 48px;
    height: 48px;
    align-items: center; 
    justify-content: center;
    
    /* Squashes the box horizontally and stretches vertically in GLOBAL space */
    scale: 0.75 1.4; 
}

/* 2. The Shape: Draws the actual rotated geometry safely inside */
.chev-shape {
    transition-property: border-color;
    transition-duration: 0.15s;
}

/* --- THE SHAPES --- */
.chev-solid {
    width: 36px; height: 36px;
    border-width: 18px; 
}
.chev-outline {
    width: 48px; height: 48px;
    border-width: 8px; 
}

/* --- THE DIRECTIONS --- */
.chev-left {
    rotate: -45deg;
    border-right-width: 0;
    border-bottom-width: 0;
}
.chev-right {
    rotate: 45deg;
    border-left-width: 0;
    border-bottom-width: 0;
}

/* --- THE COLORS --- */
.color-magenta { border-color: #E6005C; }
.color-cyan { border-color: #55ead4; }


/* ==========================================
   POSITIONS & TIGHT SPACING
========================================== */
/* Left Indicator */
.swipe-indicator--back .pos-1 { left: 15px; } 
.swipe-indicator--back .pos-2 { left: 45px; } 
.swipe-indicator--back .pos-3 { left: 69px; } 

/* Right Indicator */
.swipe-indicator--forward .pos-1 { right: 15px; }
.swipe-indicator--forward .pos-2 { right: 45px; }
.swipe-indicator--forward .pos-3 { right: 69px; }


/* ==========================================
   THE "SUCCESS" FLASH 
========================================== */
.swipe-indicator--success .chev-shape {
    border-color: #f3e600; 
}




/* ==========================================
   DIMENSIONAL RIFTS (Unity-Safe Neon Glow)
========================================== */
.portal {
    background-color: transparent; 
    border-width: 0; 
    border-radius: 50%; /* Keeps the bounding box oval */
    -unity-background-scale-mode: scale-to-fit;
}

/* ==========================================
   PORTAL WRAPPER FIX
========================================== */
/* ==========================================
   PORTAL WRAPPER FIX (Perfect Scaling Pivot)
========================================== */
.portal-wrapper {
    position: absolute; 
    top: 100px; 
    
    /* We explicitly tell the wrapper how big the rotated child is */
    width: 300px;  
    height: 100px; 
    
    align-self: center;
    align-items: center;
    justify-content: center;
    
    /* Guarantees it scales from the dead center in both directions */
    transform-origin: center; 
}

/* Ceiling Portal (Horizontal) */
.portal--horizontal-hero {
    position: absolute;
    top: 40px;
    align-self: center;
    
    /* Loads the horizontal image */
    background-image: url('project://database/Assets/Resources/Portal_Horizontal.png'); 
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #ff7300; 
    
    /* Perfect percentage scaling (Length and Thickness) */
    width: 80%; 
    height: 30%; 
}

/* Left Wall Portal (Vertical) */
.portal--vertical-header {
    /* Loads the vertical image */
    background-image: url('project://database/Assets/Resources/Portal_V.png');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #00E5FF;
    
    /* Standard fixed pixels for the header bar */
    width: 30px; 
    height: 80px; 
    margin-right: 15px; 
}

/* ==========================================
   HERO LAYOUT (Centered Text)
========================================== */
.hero-portal-container {
    width: 100%;
    height: 100%; 
    min-height: 800px; 
    flex-direction: column; 
    align-items: center;
    
    /* This automatically pushes your Name and Button to the vertical center of the screen! */
    justify-content: center; 
}


.header-side {
    flex-direction: row;
    align-items: center;
}   
.header-side--left { justify-content: flex-start; }
.header-side--right { justify-content: flex-end; }


/* ==========================================
   THE SLINGSHOT / TELEPORT ANIMATION
========================================== */
.header-teleport-item {
    transition-property: translate, opacity;
    transition-duration: 0.5s; /* Slightly longer so you can see it fly across the screen */
    transition-timing-function: ease-out-back; 
}

/* The Name pops out of the left portal */
#HeaderName.header-teleport-item--hidden {
    opacity: 0;
    translate: -60px 0; 
}

/* Normal resting state in the header */
.header-item--popped {
    scale: 1 1;
    opacity: 1;
    translate: 0 0; 
}

/* Hides Name slightly left into the portal */
#HeaderName.header-item--hidden {
    scale: 0.1 0.1;
    opacity: 0;
    translate: -60px 0; 
}

/* Yanks the Right-Side buttons 1500px to the left to hide them in the portal! */
#HeaderNav.header-item--hidden {
    scale: 0.1 0.1;
    opacity: 0;
    translate: -1500px 0; 
}

#HeaderExploreBtn.header-teleport-item--hidden {
    opacity: 0;
    translate: -1500px 0; 
}





/* ===== PORTRAIT / MOBILE OVERRIDES ===== */
/* Apparantly the uss doesnt understand @media thing at all*/

.is-mobile .header-bar,
.is-mobile .intro-content,
.is-mobile .portfolio-view,
.is-mobile .experience-section,
.is-mobile .detail-panel {
    width: 100%;
    align-items: stretch;
}

.is-mobile .header-bar {
    padding-left: 16px;
    padding-right: 16px;
}

.is-mobile .intro-headline {
    font-size: 48px;
    width: 100%;
}

.is-mobile .intro-summary {
    font-size: 19px;
    width: 100%;
}

.is-mobile .section-title {
    font-size: 32px;
}

.is-mobile .portfolio-view {
    padding: 24px 16px;
}

.is-mobile .detail-panel {
    width: 100%; 
    padding: 0; 
    max-height: none; 
}

.is-mobile .detail-title {
    font-size: 20px;
}

.is-mobile .detail-description {
    font-size: 16px;
}

.is-mobile .nav-btn {
    padding-left: 10px;
    padding-right: 10px;
}

.is-mobile .detail-image {
    height: 250px;
    margin-bottom: 24px;
}

.is-mobile .detail-meta,
.is-mobile .detail-meta-header,
.is-mobile .detail-description,
.is-mobile .detail-footer {
    padding-left: 16px;
    padding-right: 16px;
}

.is-mobile .detail-footer {
    flex-direction: column; 
    padding-bottom: 60px;
}

.is-mobile .detail-footer Button {
    margin-right: 0;
    margin-left: 0;
    margin-bottom: 12px;
    width: 100%; 
}

.is-mobile .detail-dynamic-row, 
.is-mobile .detail-dynamic-row--reverse {
    flex-direction: column; 
    margin-bottom: 40px;
}

.is-mobile .detail-dynamic-text {
    width: 100%;
    margin-bottom: 24px;
}

.is-mobile .detail-dynamic-image {
    width: 100%;
    height: 220px;
    margin-bottom: 16px;
}

.is-mobile .portal--horizontal-hero {
    width: 100%; 
    height: 25%; 
}
/* ==========================================
   MOBILE HEADER FIXES
========================================== */
.is-mobile .portal--vertical-header {
    width: 24px; 
    height: 60px;
    margin-right: 10px;
    /* CRITICAL: Prevents the text from squishing the portal */
    flex-shrink: 0; 
}

.is-mobile .header-title {
    font-size: 15px; /* Scaled down for mobile */
    flex-shrink: 1;  /* Allows the text to wrap/shrink if necessary */
    white-space: nowrap;
}

.is-mobile .header-nav .nav-btn {
    font-size: 13px; /* Smaller text for mobile nav */
    padding-left: 8px;
    padding-right: 8px;
    margin-right: 6px; /* Tighter button spacing */
}


/* 	#000000	(0,0,0) black
#c5003c	(197,0,60) bright red
#880425	(136,4,37) dark red
#f3e600	(243,230,0) yellow
#55ead4	(85,234,212) cyan */