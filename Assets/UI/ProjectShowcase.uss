.showcase-row {
    width: 100%;
    flex-direction: row;
    min-height: 360px;
    margin-bottom: 36px;
    padding: 24px;
    align-items: center;
    background-color: #14161F;
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 14px;
    overflow: hidden;
    transition-property: border-color, translate, opacity;
    transition-duration: 0.2s, 0.2s, 0.4s;
}

.showcase-row:hover {
    border-color: rgba(0, 229, 255, 0.5);
    translate: 0 -3px 0;
}

.showcase-row--reverse {
    flex-direction: row-reverse;
}

.showcase-column {
    flex-direction: column;
    justify-content: center;
}

.showcase-column--image {
    width: 52%;
    padding-left: 12px;
    padding-right: 12px;
}

.showcase-column--info {
    width: 48%;
    padding-left: 20px;
    padding-right: 20px;
    gap: 10px;
}

.project-image {
    width: 100%;
    height: 300px;
    background-color: #0B0C10;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.platform-badge {
    position: absolute;
    top: 14px;
    right: 14px;
    background-color: rgba(11, 12, 16, 0.9);
    color: #00E5FF;
    border-color: rgba(0, 229, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11px;
    -unity-font-style: bold;
}

.tag-container {
    flex-direction: row;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.tech-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 4px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 4px;
}

.project-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
}

.project-description {
    font-size: 14px;
    color: #8E95A5;
    white-space: normal;
    line-height: 22px;
    margin-bottom: 12px;
}

.button-row {
    flex-direction: row;
    gap: 12px;
    align-items: center;
}

@media (max-width: 1080px) {
    .showcase-row {
        flex-direction: column;
        padding: 18px;
    }

    .showcase-row--reverse {
        flex-direction: column;
    }

    .showcase-column--image {
        width: 100%;
        margin-bottom: 16px;
    }

    .showcase-column--info {
        width: 100%;
        padding-left: 0;
        padding-right: 0;
    }

    .project-image {
        height: 220px;
    }
}