<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<Style src="project://database/Assets/UI/ProjectShowcase.uss" />
	<ui:VisualElement class="showcase-row">
		<!-- Image Column (55%) -->
		<ui:VisualElement class="showcase-column showcase-column--image">
			<ui:VisualElement name="ProjectImage" class="project-image">
				<ui:Label name="ProjectPlatformTag" class="platform-badge" text="Platform" />
			</ui:VisualElement>
		</ui:VisualElement>

		<!-- Info Column (45%) -->
		<ui:VisualElement class="showcase-column showcase-column--info">
			<ui:VisualElement class="tag-container">
				<ui:Label class="tech-pill" text="Tech 1" />
				<ui:Label class="tech-pill" text="Tech 2" />
				<ui:Label class="tech-pill" text="Tech 3" />
			</ui:VisualElement>

			<ui:Label name="ProjectTitle" class="project-title" text="Project Title" />
			<ui:Label name="ProjectDescription" class="project-description" text="Project Description" />

			<ui:VisualElement class="button-row">
				<ui:Button name="BtnCaseStudy" class="btn-primary" text="View Case Study" />
				<ui:Button name="BtnGitHub" class="btn-secondary" text="GitHub" />
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
