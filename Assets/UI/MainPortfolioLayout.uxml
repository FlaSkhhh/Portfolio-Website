<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Style src="project://database/Assets/UI/MainPortfolioLayout.uss" />
    <ui:VisualElement class="main-container">

        <!-- Header -->
        <ui:VisualElement class="header-bar">
            <ui:Label class="header-title" text="Shantanu Nandkhile" />
            <ui:VisualElement class="header-nav">
                <ui:Button name="NavContact" class="nav-btn" text="Contact" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main Scrollable Body (Added Name & Permanent Scrollbar here) -->
        <ui:ScrollView name="MainScrollArea" class="content-area" vertical-scroller-visibility="Hidden">
            
            <!-- Hero / Intro -->
            <ui:VisualElement name="IntroView" class="intro-view">
                <ui:VisualElement class="intro-content">
                    <ui:Label class="intro-headline" text="Systems &amp; Multiplayer Game Programmer" />
                    <ui:Label class="intro-summary" text="Passionate game systems engineer with production experience in Unity. Specialized in multiplayer architecture, network gameplay, and optimized WebGL/mobile experiences." />
                    <ui:Button name="BtnEnter" class="btn-enter btn-primary" text="Explore Portfolio" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Main Portfolio Section -->
            <ui:VisualElement name="MainPortfolioView" class="portfolio-view">
                
                <ui:Button name="BtnBackToHome" class="btn-secondary btn-back-home" text="←" />

                <ui:VisualElement class="experience-section">
                    <ui:Label class="section-title" text="Featured Projects" />
                    <ui:Label class="section-subtitle" text="A selection of core engineering work in multiplayer architecture, shaders, and AI systems." />
                </ui:VisualElement>
                 <!-- NEW: Retro Arcade Loading Screen -->
                <ui:VisualElement name="LoadingScreen" class="loading-screen">
                    <ui:VisualElement class="retro-container">
                        <ui:Label name="LoadingText" class="retro-text" text="INSERT COIN..." />
                
                        <!-- The track the character moves along -->
                        <ui:VisualElement class="retro-track">
                            <!-- Dots for the track -->
                            <ui:VisualElement class="retro-dot" style="left: 25%;" />
                            <ui:VisualElement class="retro-dot" style="left: 50%;" />
                            <ui:VisualElement class="retro-dot" style="left: 75%;" />
                            <ui:VisualElement class="retro-dot" style="left: 100%;" />
                    
                            <!-- The moving character -->
                            <ui:VisualElement name="LoadingCharacter" class="retro-character" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <!-- Converted from ScrollView to VisualElement -->
                <ui:VisualElement name="ProjectScrollView" class="project-scroll-view" />

                <!-- Gaming Shelf -->
                <ui:VisualElement name="GamingShelfView" class="gaming-shelf">
                    <ui:Label class="section-title" text="Competitive Shelf" />
                    <ui:VisualElement class="gaming-shelf-content">
                        <ui:Label class="game-card" text="🏆 Clash Royale" />
                        <ui:Label class="game-card" text="⚔️ Counter-Strike 2" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>

        <ui:Label name="ScrollChevron" class="scroll-chevron" text="↓" picking-mode="Ignore" />
        <!-- Upgraded Modal Overlay -->
        <ui:VisualElement name="ProjectDetailView" class="project-detail-view" style="display: none;">
            <!-- Dark blurred backdrop -->
            <ui:VisualElement name="DetailBackdrop" class="detail-overlay-bg" />

            <!-- Floating Modal Card -->
            <ui:VisualElement class="detail-panel">
                <!-- Header with Back Button and Title -->
                <ui:VisualElement class="detail-header-row">
                    <ui:Button name="BtnBack" class="btn-secondary btn-detail-back" text="←" />
                    <ui:Label name="DetailTitle" class="detail-title" text="Project Title" />
                </ui:VisualElement>

                <!-- Scrollable Body for Deep Technical Breakdown -->
                <ui:ScrollView class="detail-scroll-area">
                    <ui:VisualElement name="DetailImage" class="detail-image" />
                    
                    <ui:VisualElement class="detail-meta">
                        <ui:Label text="TECH STACK" class="detail-meta-header" />
                        <ui:VisualElement name="DetailTagsContainer" class="detail-tag-container" />
                    </ui:VisualElement>

                    <ui:Label text="OVERVIEW &amp; ARCHITECTURE" class="detail-meta-header" />
                    <ui:Label name="DetailDescription" class="detail-description" text="Full breakdown..." />
                </ui:ScrollView>

                <!-- Sticky Footer Buttons -->
                <ui:VisualElement class="detail-footer">
                    <ui:Button name="BtnDetailGitHub" class="btn-secondary" text="GitHub Repository" />
                    <ui:Button name="BtnDetailDemo" class="btn-primary" text="Live Demo / Build" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>