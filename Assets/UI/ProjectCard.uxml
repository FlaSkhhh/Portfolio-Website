<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Style src="project://database/Assets/UI/ProjectCard.uss" />
    <ui:VisualElement class="project-card">
        <ui:VisualElement class="card-image-container">
            <ui:Label class="card-tag" text="Tag" />
        </ui:VisualElement>
        <ui:Label class="card-title" text="Project Title" />
        <ui:Label class="card-description" text="Project Description" />
        <ui:Button class="btn-case-study" text="View Case Study" />
    </ui:VisualElement>
</ui:UXML>