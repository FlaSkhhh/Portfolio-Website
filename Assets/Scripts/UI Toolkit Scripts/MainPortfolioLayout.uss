/* ===== GLOBAL TYPOGRAPHY ===== */
* {
    -unity-font-definition: url('project://database/Assets/Resources/Inter-Regular.ttf');
}
/* Cyberpunk display font for Headers, Buttons, and Retro text */
.cyber-text,
.header-title,
.titlesection-,
.detail-title,
.detail-meta-header,
.hero-title,
.hero-subtitle,
.contact-name,
.cyber-header,
.intro-section-title{
    -unity-font-definition: url('project://database/Assets/Resources/Orbitron-Regular.ttf');
}
Scroller {
    display: none;
}

.main-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: transparent; 
    color: #FFFFFF;
}

/* ===== BASE BUTTON RESET ===== */
Button {
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-radius: 8px; /* Kept for standard UI buttons, overridden for Cyber buttons */
    min-height: 48px;
    height: 48px;
    padding-left: 24px;
    padding-right: 24px;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: flex-start;
    white-space: nowrap;
    transition-property: background-color, scale;
    transition-duration: 0.15s, 0.15s;
}

/* ===== CYBERPUNK ACTION BUTTONS (Sprite-Based) ===== */
.cyber-btn {
    background-color: transparent;
    border-width: 0;
    border-radius: 0; /* Prevents Unity from clipping the sharp PNG corners */
    min-width: 240px;
    height: 52px;
    margin-right: 24px;
    margin-top: 16px;
    justify-content: center;
    align-items: center;
}

.cyber-shadow, 
.cyber-body {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    
    background-image: url('project://database/Assets/Resources/CP_Button_White.png');
    
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.cyber-shadow {
    translate: 6px 0; 
}

.cyber-text {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: #000000;
}
.cyber-header {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: -4px;
    color: #000000;
}

/* ==========================================
   CYBERPUNK BUTTON COLOR PRESETS
========================================== */

/* 1. PRIMARY: Yellow Body / Cyan Accent / Black Text */
.cyber-btn.primary .cyber-body { -unity-background-image-tint-color: #f3e600; }
.cyber-btn.primary .cyber-shadow { -unity-background-image-tint-color: #55ead4; }
.cyber-btn.primary .cyber-text { color: #000000; }
.cyber-btn.primary:hover .cyber-body { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.primary:hover .cyber-shadow { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.primary:hover .cyber-text { color: #f3e600; text-shadow: 0 0 10px rgba(243, 230, 0, 0.8); }

/* 2. SECONDARY: Dark Red Body / Bright Red Accent / Cyan Text */
.cyber-btn.secondary .cyber-body { -unity-background-image-tint-color: #880425; } 
.cyber-btn.secondary .cyber-shadow { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.secondary .cyber-text { color: #55ead4; } 
.cyber-btn.secondary:hover .cyber-body { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.secondary:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.secondary:hover .cyber-text { color: #000000; }

/* 3. TERTIARY (The 3-Color Special): Bright Red Body / Yellow Accent / Cyan Text */
.cyber-btn.tertiary .cyber-body { -unity-background-image-tint-color: #c5003c; } 
.cyber-btn.tertiary .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.tertiary .cyber-text { color: #55ead4; } 
.cyber-btn.tertiary:hover .cyber-body { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.tertiary:hover .cyber-shadow { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.tertiary:hover .cyber-text { color: #c5003c; text-shadow: 0 0 10px rgba(197, 0, 60, 0.8); }

/* 4. QUATERNARY: Hot Pink / Neon Green / Black Text */
.cyber-btn.quaternary .cyber-body { -unity-background-image-tint-color: #FF007C; } 
.cyber-btn.quaternary .cyber-shadow { -unity-background-image-tint-color: #00FF9D; } 
.cyber-btn.quaternary .cyber-text { color: #000000; } 
.cyber-btn.quaternary:hover .cyber-body { -unity-background-image-tint-color: #00FF9D; } 
.cyber-btn.quaternary:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.quaternary:hover .cyber-text { color: #FF007C; text-shadow: 0 0 10px rgba(255, 0, 124, 0.8); }

/* 5. GHOST / HACKER: Black Body / Cyan Accent / Yellow Text */
.cyber-btn.ghost .cyber-body { -unity-background-image-tint-color: rgba(11, 12, 16, 0.95); } 
.cyber-btn.ghost .cyber-shadow { -unity-background-image-tint-color: #55ead4; } 
.cyber-btn.ghost .cyber-text { color: #f3e600; } 
.cyber-btn.ghost:hover .cyber-body { -unity-background-image-tint-color: rgba(85, 234, 212, 0.2); } 
.cyber-btn.ghost:hover .cyber-shadow { -unity-background-image-tint-color: #f3e600; } 
.cyber-btn.ghost:hover .cyber-text { color: #55ead4; text-shadow: 0 0 10px rgba(85, 234, 212, 0.8); }




/* ===== SOLID NEON SQUARE BACK BUTTONS ===== */
.btn-back {
    background-color: #55ead4; /* Solid Cyan */
    color: #000000; /* Black Text */
    border-width: 0;
    border-radius: 0; /* Sharp Square */
    
    border-left-width: 6px;
    border-left-color: #c5003c; /* Red left accent */
    
    height: 44px;
    padding-left: 20px;
    padding-right: 24px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color, scale;
    transition-duration: 0.15s;
}

.btn-back:hover {
    background-color: #f3e600; /* Swaps to Yellow */
    color: #000000;
    border-left-color: #55ead4; /* Swaps accent to Cyan */
    scale: 1.05 1.05;
}

.btn-detail-back { font-size: 24px; margin-right: 16px; height: 40px; }

/* ==========================================
   TOUCH / CLICK FEEDBACK (The "Push" Effect)
========================================== */
/* Targets every standard UI Toolkit Button, Cyber Buttons, and Back Buttons */
.cyber-btn:active .cyber-body,
.cyber-btn:active .cyber-shadow,
.cyber-btn:active .cyber-text {
    scale: 0.95 0.95; 
    transition-duration: 0.05s;
}

/* 2. Standard Buttons: Nudges them down physically instead of shrinking them */
Button:active,
.btn-back:active,
.nav-btn:active {
    translate: 0 2px 0; 
    transition-duration: 0.05s;
}

/* 3. Nav Button Flash (Keeps your color change) */
.nav-btn:active {
    background-color: rgba(255, 255, 255, 0.15);
    color: #00E5FF;
}

/* ===== HEADER ===== */
.header-bar {
    height: 64px;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    justify-content: space-between;
    flex-shrink: 0;
}

.header-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

/* ===== CONTENT AREA ===== */
.content-area {
    flex-grow: 1;
    width: 100%;
}

.intro-view {
    width: 100%;
    flex-direction: column;
    align-items: center;
    /* Pushes content from the top down so scrolling works naturally */
    justify-content: flex-start; 
    padding: 0; 
}

.portfolio-view {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    display: none;
    flex-direction: column;
    padding: 40px 24px;
}

.portfolio-header-row {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
    border-bottom-width: 0px;
    padding: 12px 32px;
    flex-shrink: 0;
}

.experience-section {
    margin-bottom: 36px;
}

.section-title {
    color: rgb(0, 229, 255);
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 40px;
}

.section-subtitle {
    font-size: 24px;
    color: #8E95A5;
}

.project-scroll-view {
    width: 100%;
    flex-direction: column;
}

/* ===== FULL PAGE CASE STUDY ===== */
.project-detail-view {
    width: 100%;
    flex-grow: 1; 
    background-color: transparent;
}

.detail-panel {
    width: 100%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
    padding: 0;
    flex-direction: column;
}

.detail-header-row {
    flex-direction: row;
    align-items: center;
    background-color: #14161F;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding: 12px 32px;
}

.detail-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #FFFFFF;
    flex-grow: 1;
}

.detail-scroll-area {
    flex-grow: 1;
    width: 100%;
}

.detail-image {
    width: 100%;
    max-width: 1000px; 
    align-self: center; 
    height: 450px; 
    min-height: 300px;
    max-height: 600px;
    background-color: #0B0C10;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-top: 32px; 
    margin-bottom: 40px;
    -unity-background-scale-mode: scale-to-fit; 
}

.detail-meta,
.detail-meta-header,
.detail-description,
.detail-dynamic-content,
.detail-footer {
    width: 100%;
    max-width: 900px;
    align-self: center; 
    padding-left: 24px;
    padding-right: 24px;
}

.detail-meta-header {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: #00E5FF;
    margin-top: 16px;
    margin-bottom: 12px;
}

.detail-tag-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 32px;
}

.detail-description {
    font-size: 24px;
    color: #C0C5D0;
    white-space: normal;
    margin-bottom: 48px; 
}

.detail-footer {
    flex-direction: row;
    justify-content: flex-start; 
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 32px;
    padding-bottom: 100px; 
}

.detail-footer Button {
    margin-right: 16px;
}
/* ===== ALTERNATING ZIGZAG CASE STUDY ROWS ===== */
.detail-dynamic-row {
    flex-direction: row;
    width: 100%;
    align-items: center; /* Vertically centers the text alongside the image */
    margin-bottom: 56px; /* Heavy breathing room between sections */
}

/* Instantly flips the flexbox layout so Image is Left and Text is Right */
.detail-dynamic-row--reverse {
    flex-direction: row-reverse;
}
.detail-dynamic-row--reverse .detail-dynamic-text {
    padding-left: 0;
    padding-right: 40px; 
}

.detail-dynamic-image {
    width: 50%; /* Uses safe percentage scaling instead of hard pixels */
    max-width: 450px; 
    height: 300px; 
    flex-shrink: 0; /* Prevents the image from being squished by long text */
    
    background-color: transparent; 
    border-width: 0; 
    
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
    align-items: center;
}

.detail-dynamic-text {
    flex-grow: 1;
    flex-shrink: 1; /* Allows the text box to compress dynamically */
    font-size: 24px;
    color: #C0C5D0;
    white-space: normal;
    padding-left: 40px; 
}

/* Kicks in dynamically via C# when there is no image on the row */
.detail-dynamic-text--full {
    width: 100%;
    padding-left: 0;
    padding-right: 0;
}


/* ===== CP LOADING SCREEN ===== */
.loading-screen {
    width: 100%;
    height: 120px;
    background-color: transparent;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.retro-container {
    width: 300px;
    flex-direction: column;
    align-items: center;
}


.cyber-spinner {
    width: 64px;
    height: 64px;
    border-width: 4px;
    border-radius: 50%; /* Creates a perfect circle */
    
    /* Creates a dashed neon ring effect */
    border-color: rgba(85, 234, 212, 0.1); 
    border-top-color: #55ead4; 
    border-right-color: #FF007C; 
}

/* ===== CSS-ONLY SOLID TRIANGLE CHEVRON ===== */
.scroll-chevron {
    position: absolute;
    bottom: 32px; 
    align-self: center;
    
    width: 0;
    height: 0;
    background-color: transparent;
    
    border-left-width: 16px;
    border-right-width: 16px;
    border-top-width: 20px;
    border-bottom-width: 0;
    
    border-left-color: rgba(0,0,0,0);
    border-right-color: rgba(0,0,0,0);
    border-top-color: #f3e600; 
    
    transition-property: opacity, translate;
    transition-duration: 0.3s;
}

.scroll-chevron--hidden {
    opacity: 0;
    translate: 0 10px;
}

/* ===== SKELETON LOADER ===== */
.skeleton-loader {
    background-color: rgba(0, 0, 0, 0.6);
    border-color: rgba(243, 230, 0, 0.3); 
    border-width: 2px;
    border-radius: 12px; 
    justify-content: center;
    align-items: center;
}

.skeleton-text {
    color: #f3e600; 
    font-size: 18px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* ==========================================
   THE INVISIBLE CONTAINER
========================================== */
.swipe-indicator {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 140px;  
    height: 100px;  
    
    display: none; 
    opacity: 0;
    
    transition-property: translate, scale, opacity;
    transition-duration: 0.1s, 0.15s, 0.15s; 
    transition-timing-function: ease-out-bounce;
}

.swipe-indicator--back { left: -140px; }
.swipe-indicator--forward { right: -140px; }


/* ==========================================
   TRANSFORM SEPARATION (The Symmetry Fix!)
========================================== */

/* 1. The Wrapper: Handles positioning and global squashing */
.chev-scaler {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    
    width: 48px;
    height: 48px;
    align-items: center; 
    justify-content: center;
    
    /* Squashes the box horizontally and stretches vertically in GLOBAL space */
    scale: 0.75 1.4; 
}

/* 2. The Shape: Draws the actual rotated geometry safely inside */
.chev-shape {
    transition-property: border-color;
    transition-duration: 0.15s;
}

/* --- THE SHAPES --- */
.chev-solid {
    width: 36px; height: 36px;
    border-width: 18px; 
}
.chev-outline {
    width: 48px; height: 48px;
    border-width: 8px; 
}

/* --- THE DIRECTIONS --- */
.chev-left {
    rotate: -45deg;
    border-right-width: 0;
    border-bottom-width: 0;
}
.chev-right {
    rotate: 45deg;
    border-left-width: 0;
    border-bottom-width: 0;
}

/* --- THE COLORS --- */
.color-magenta { border-color: #E6005C; }
.color-cyan { border-color: #55ead4; }


/* ==========================================
   POSITIONS & TIGHT SPACING
========================================== */
/* Left Indicator */
.swipe-indicator--back .pos-1 { left: 15px; } 
.swipe-indicator--back .pos-2 { left: 45px; } 
.swipe-indicator--back .pos-3 { left: 69px; } 

/* Right Indicator */
.swipe-indicator--forward .pos-1 { right: 15px; }
.swipe-indicator--forward .pos-2 { right: 45px; }
.swipe-indicator--forward .pos-3 { right: 69px; }


/* ==========================================
   THE "SUCCESS" FLASH 
========================================== */
.swipe-indicator--success .chev-shape {
    border-color: #f3e600; 
}




/* ==========================================
   DIMENSIONAL RIFTS (Unity-Safe Neon Glow)
========================================== */
.portal {
    background-color: transparent; 
    border-width: 0; 
    border-radius: 50%; /* Keeps the bounding box oval */
    -unity-background-scale-mode: scale-to-fit;
}


/* Ceiling Portal (Horizontal) */
.portal--horizontal-hero {
    position: absolute;
    top: 40px;
    align-self: center;
    
    /* Loads the horizontal image */
    background-image: url('project://database/Assets/Resources/Portal_Horizontal.png'); 
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #ff7300; 
    
    /* Perfect percentage scaling (Length and Thickness) */
    width: 80%; 
    height: 30%; 
}

/* Left Wall Portal (Vertical) */
.portal--vertical-header {
    /* Loads the vertical image */
    background-image: url('project://database/Assets/Resources/Portal_V.png');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: #00E5FF;
    
    /* Standard fixed pixels for the header bar */
    width: 30px; 
    min-width : 30px;
    height: 80px; 
    min-height: 80px;
    margin-right: 15px; 
}

/* ==========================================
   HERO LAYOUT (Centered Text)
========================================== */
.hero-portal-container {
    width: 100%;
    height: 100%; 
    min-height: 800px; 
    flex-direction: column; 
    align-items: center;
    
    /* This automatically pushes your Name and Button to the vertical center of the screen! */
    justify-content: center; 
}


.header-side {
    flex-direction: row;
    align-items: center;
}   
.header-side--left { justify-content: flex-start; }
.header-side--right { justify-content: flex-end; }


/* ==========================================
   THE SLINGSHOT / TELEPORT ANIMATION
========================================== */
.header-teleport-item {
    transition-property: translate, opacity, scale; 
    transition-duration: 0.5s; 
    transition-timing-function: ease-out-back; 
}

/* Resting state */
.header-teleport-item--popped {
    scale: 1 1;
    opacity: 1;
    translate: 0 0; 
}

/* Name hides left */
#HeaderName.header-teleport-item--hidden {
    scale: 0.1 0.1;
    opacity: 0;
    translate: -60px 0; 
    min-width: 300px
}

/* Explore Button hides WAY left */
#HeaderExploreBtn.header-teleport-item--hidden {
    scale: 0.1 0.1;
    opacity: 0;
    translate: -1500px 0; 
}
/* ==========================================
   DESKTOP HEADER BUTTONS (Standardized)
========================================== */
#HeaderExploreBtn,
#NavContact,
#BtnDownloadCV {
    min-width: 140px;
    height: 40px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 30px; /* Perfect desktop gap */
    padding: 0;
}

/* Locks the text size since inline styles are gone */
#HeaderExploreBtn .cyber-text,
#NavContact .cyber-text,
#BtnDownloadCV .cyber-text {
    font-size: 17px; 
    letter-spacing: -4px;
}

/* Keeps the final button completely flush with the right edge */
#BtnDownloadCV {
    margin-right: 0;
}

/*======================================
INTRO STUFF
=======================================*/

/* The big "HELLO THERE, I'M SHANTANU" text */
.hero-title {
    font-size: 54px;                 /* Restored your original size */
    -unity-font-style: bold;
    color: #FFFFFF;                  /* Restored your hex color */
    white-space: normal;             /* CRITICAL: Allows the &#10; line break to work */
    -unity-text-align: middle-center;
    /* No margin-bottom here, so the subtitle can tuck up close to it */
}

.hero-subtitle {
    font-size: 34px;                 /* Sized down to look good under a 48px title */
    -unity-font-style: normal;
    color: rgb(180, 180, 180);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-top: 10px;                /* Pulls it slightly up toward the title */
    margin-bottom: 24px;             /* RESTORED: Pushes the Projects button down */
}

/* ==========================================
   CV / EXPERIENCE TIMELINE
========================================== */
.cv-section {
    width: 87%;
    max-width: 1200px;
    align-items: flex-start; /* Aligns the timeline to the left */
    margin-top: 60px;
    margin-bottom: 60px;
}

.cv-tag-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
}

.timeline-box {
    width: 100%;
    border-left-width: 2px;
    border-left-color: #00E5FF; /* Glowing cyan laser line */
    padding-left: 32px; /* Space between line and text */
    margin-bottom: 40px;
    
    /* Adds a subtle dark gradient box behind the text */
    background-color: rgba(11, 12, 16, 0.4);
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-right: 24px;
}

.timeline-header-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.timeline-title {
    color: #FFFFFF;
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.timeline-date {
    color: #f3e600; /* Yellow */
    font-size: 18px;
    -unity-font-style: bold;
}

.timeline-bullets {
    flex-direction: column;
}

.timeline-text {
    color: #C0C5D0;
    font-size: 24px;
    white-space: normal;
    margin-bottom: 16px;
}

.education-text {
    color: white; 
    font-size: 30px; 
    margin-bottom: 16px; 
    -unity-font-style: bold;
}

/* ==========================================
   RESUME SKILLS (Larger than project tags)
========================================== */
.skill-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 10px 20px;
    font-size: 18px; 
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.4); /* Slightly brighter border */
    border-radius: 6px;
    margin-right: 12px;
    margin-bottom: 12px;
}


.about-section {
    width: 87%;
    align-items: center;
    margin-top: 100px;
    margin-bottom: 80px;
}

.intro-section-title {
    color: rgb(0, 229, 255);
    margin-bottom: 100px;
    font-size: 50px;
    -unity-font-style: bold;
}
.about-content-container {
    margin-top: 100px;
    flex-direction: column;
    align-items: center; /* Centers the image and text horizontally */
    width: 100%;         /* Allows the container to scale automatically */
    height: auto;
}

.about-top-row {
    width: 100%;             /* Guarantee it fills the screen width */
    flex-direction: row;
    flex-wrap: wrap;         /* Safety net: lets text wrap if screen gets small */
    align-items: flex-start; /* Aligns image and text to the top */
}


.about-paragraph {
    color: rgb(200, 200, 200);
    font-size: 30px;
    white-space: normal;
}

.about-paragraph--top {
    flex-grow: 1;
    flex-shrink: 1;     /* was 0 — must be allowed to shrink below 300px on narrower desktop widths */
    flex-basis: 300px;  /* correct here: .about-top-row is a row container, so this is WIDTH */
}
.about-paragraph--bottom {
    width: 100%;         /* explicit width since .about-bottom-area is a column container */
    /* no flex-basis here on purpose — height comes from wrapped content, not a fixed number */
}
.about-bottom-area {
    width: 100%;
    flex-direction: column; /* was relying on Unity's default — making it explicit so this exact
                                 shared-class-different-context trap can't happen again by accident */
}


.profile-image-circle {
    width: 250px;
    height: 250px;
    border-radius: 125px;
    background-color: rgb(20, 20, 20);
    border-width: 2px;
    border-color: rgba(0, 229, 255, 0.4);
    overflow: hidden;
    flex-shrink: 0;
    margin-right: 40px;
    margin-bottom: 20px; 
}


/* ==========================================
   CONTACT MODAL
========================================== */

/* The dark, blurry background covering the whole screen */
.modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(11, 12, 16, 0.90); /* Dark Cyberpunk BG */
    align-items: center;
    justify-content: center;
    
    opacity: 1;
    visibility: visible;
    transition-property: opacity, visibility;
    transition-duration: 0.3s, 0s; 
    transition-delay: 0s, 0s;
}

/* The actual Popup Container */
.modal-box {
    width: 80%;
    height: 40%;
    max-width: 750px; /* Much Wider */
    min-height: 480px; /* Much Taller */
    max-height: 540px;

    background-color: #14161F;
    border-color: #00E5FF;
    border-width: 2px;
    border-radius: 0; /* Sharp corners fit the glitch aesthetic better */
    
    padding: 60px 40px;
    align-items: center;
    justify-content: center; /* Spreads the Top, Middle, and Bottom elements perfectly */
    overflow: hidden;

    /* Extremely fast transitions make the class-swapping look like a violent glitch */
    transition-property: scale, translate, opacity, border-color;
    transition-duration: 0.04s; 
    transition-timing-function: linear;
}

.btn-modal-back {
    position: absolute;
    height: 40px;
    top: 40px;
    left: 40px;
    flex-shrink: 0;
    font-size: 24px;
}

.btn-modal-close:hover {
    color: #f3e600;
    scale: 1.1 1.1;
}

.contact-header-row {
    position: absolute;
    top: 25px; /* Aligns perfectly with your Back button's top margin! */
    left: 0;
    right: 0;
    align-items: center; /* Centers the text horizontally */
}

.contact-name {
    margin-top: 20px;
    color: #00E5FF;
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* --- INVISIBLE, SELECTABLE TEXT FIELDS --- */
.data-field {
    /* Very tight margins to keep them close together */
    margin-top: 50px;
    margin-bottom: -20px;
    width: 88%;
}

/* Target the internal box of the TextField to strip away the default styling */
.data-field > .unity-text-field__input {
    flex-grow: 1;
    background-color: transparent; /* Removes the dark box */
    border-width: 0;               /* Removes the border */
    padding: 0;                    /* Removes default internal padding */
    
    color: #C8C8C8;                /* Light grey text */
    font-size: 30px;               /* Much bigger font */
    -unity-text-align: middle-left; /* Perfectly centers the text */
    transition-duration: 0.1s;
}
/* Optional: When they click/highlight the text, make it light up Cyan so they know it worked! */
.data-field > .unity-text-field__input:focus {
    color: #00E5FF; 
    background-color: transparent;
    border-width: 0;
}

/* Puts the GitHub and LinkedIn buttons side-by-side */
.contact-btn-row {
    position: absolute;
    bottom: 40px; /* Anchors it 40px from the floor */
    left: 0;
    right: 0;
    flex-direction: row; 
    justify-content: center; 
    width: 100%;
}

.contact-btn-row .cyber-btn {
    margin-left: 8px;
    margin-right: 8px;
}


/* --- THE GLITCH ANIMATION STATES --- */


.glitch-1, .glitch-2, .glitch-3, .glitch-4, .glitch-5, .glitch-6 {
    transition-duration: 0s;
}

/* ===== BOX FRAMES ===== */

.glitch-1 { /* power-on collapse, squashed to a line (no sideways shove) */
    scale: 1 0.04;
    opacity: 0.9;
    border-color: #FF007C;
}
.glitch-2 { /* dropout */
    opacity: 0.35;
    border-color: #f3e600;
}
.glitch-3 { /* back, with a tiny nudge */
    translate: 3px 0;
    opacity: 1;
    border-color: #55ead4;
}
.glitch-4 { /* second dropout */
    opacity: 0.55;
    border-color: #FF007C;
}
.glitch-5 { /* near-stable, one more 2px nudge */
    translate: -2px 0;
    opacity: 1;
    border-color: #f3e600;
}
.glitch-6 { /* last blink before settling */
    opacity: 0.75;
    border-color: #55ead4;
}
/* ===== RGB-SPLIT GHOSTS (outline only) ===== */

.glitch-ghost {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    border-width: 2px;
    border-radius: 0;
    opacity: 0;
}

.glitch-ghost--cyan { border-color: #55ead4; }
.glitch-ghost--pink { border-color: #FF007C; }

.glitch-1 .glitch-ghost--cyan { opacity: 0.9; translate: -5px 0; }
.glitch-1 .glitch-ghost--pink { opacity: 0.9; translate: 5px 0; }
.glitch-2 .glitch-ghost--cyan { opacity: 0.8; translate: -4px 1px; }
.glitch-2 .glitch-ghost--pink { opacity: 0.8; translate: 4px -1px; }
.glitch-3 .glitch-ghost--cyan { opacity: 0.7; translate: -3px 0; }
.glitch-3 .glitch-ghost--pink { opacity: 0.7; translate: 3px 0; }
.glitch-4 .glitch-ghost--cyan { opacity: 0.6; translate: -4px 0; }
.glitch-4 .glitch-ghost--pink { opacity: 0.6; translate: 4px 0; }
.glitch-5 .glitch-ghost--cyan { opacity: 0.5; translate: -2px 0; }
.glitch-5 .glitch-ghost--pink { opacity: 0.5; translate: 2px 0; }

/* ===== TEAR BARS ===== */

.glitch-bar {
    position: absolute;
    left: 0; right: 0;
    opacity: 0;
}

.glitch-bar--a { background-color: rgba(243, 230, 0, 0.55); }
.glitch-bar--b { background-color: rgba(255, 0, 124, 0.45); }

.glitch-1 .glitch-bar--a { opacity: 1; top: 18%; height: 6px;  translate: 40px 0; }
.glitch-1 .glitch-bar--b { opacity: 1; top: 70%; height: 3px;  translate: -30px 0; }

.glitch-2 .glitch-bar--a { opacity: 1; top: 62%; height: 4px;  translate: -48px 0; }
.glitch-2 .glitch-bar--b { opacity: 1; top: 30%; height: 10px; translate: 36px 0; }

.glitch-3 .glitch-bar--a { opacity: 1; top: 8%;  height: 3px;  translate: 28px 0; }
.glitch-3 .glitch-bar--b { opacity: 1; top: 82%; height: 5px;  translate: -40px 0; }

.glitch-4 .glitch-bar--a { opacity: 1; top: 44%; height: 8px;  translate: 24px 0; }
.glitch-4 .glitch-bar--b { /* full-height color wash instead of a strip */
    opacity: 0.25; top: 0; height: 100%; translate: 0 0;
}
.glitch-5 .glitch-bar--a { opacity: 1; top: 26%; height: 3px;  translate: -20px 0; }
.glitch-5 .glitch-bar--b { opacity: 1; top: 90%; height: 4px;  translate: 18px 0; }

.glitch-amb-1, .glitch-amb-2, .glitch-amb-3 {
    transition-duration: 0s; /* hard snaps, same reason as the open/close frames */
}

.glitch-amb-1 { border-color: #FF007C; }
.glitch-amb-1 .glitch-ghost--cyan { opacity: 0.7; translate: -3px 0; }
.glitch-amb-1 .glitch-ghost--pink { opacity: 0.7; translate: 3px 0; }

.glitch-amb-2 { border-color: #f3e600; }
.glitch-amb-2 .glitch-bar--a { opacity: 1; top: 34%; height: 2px; translate: 26px 0; }

.glitch-amb-3 { border-color: #55ead4; }
.glitch-amb-3 .glitch-ghost--cyan { opacity: 0.6; translate: -2px 1px; }
.glitch-amb-3 .glitch-ghost--pink { opacity: 0.6; translate: 2px -1px; }

.glitch-out-final { /* the collapsed line shrinks to a dot and vanishes */
    transition-duration: 0s;
    scale: 0.02 0.04;
    translate: 0 0;
    opacity: 0;
    border-color: #f3e600;
}

/* --- THE HIDDEN OVERLAY --- */
.modal-overlay--hidden {
    opacity: 0;
    visibility: hidden;
    transition-delay: 0s, 0.2s; /* Waits for opacity to fade before turning invisible */
}

/* Remove the old scale shrinking from the hidden state, our C# glitch handles it now! */
.modal-overlay--hidden .modal-box {
    opacity: 0;
}

/* ===== PORTRAIT / MOBILE OVERRIDES ===== */
/* Apparantly the uss doesnt understand @media thing at all*/

.is-mobile .header-bar,
.is-mobile .intro-content,
.is-mobile .portfolio-view,
.is-mobile .experience-section,
.is-mobile .detail-panel {
    width: 100%;
    align-items: stretch;
}

.is-mobile .header-bar {
    padding-left: 16px;
    padding-right: 16px;
}

.is-mobile .section-title {
    font-size: 32px;
}

.is-mobile .portfolio-view {
    padding: 24px 16px;
}

.is-mobile .detail-panel {
    width: 100%; 
    padding: 0; 
    max-height: none; 
}

.is-mobile .detail-title {
    font-size: 20px;
}

.is-mobile .detail-description {
    font-size: 16px;
}

.is-mobile .nav-btn {
    padding-left: 10px;
    padding-right: 10px;
}

.is-mobile .detail-image {
    height: 250px;
    margin-bottom: 24px;
}

.is-mobile .detail-meta,
.is-mobile .detail-meta-header,
.is-mobile .detail-description {
    padding-left: 16px;
    padding-right: 16px;
}


.is-mobile .detail-dynamic-row, 
.is-mobile .detail-dynamic-row--reverse {
    flex-direction: column; 
    margin-bottom: 40px;
}

.is-mobile .detail-dynamic-text {
    width: 100%;
    margin-bottom: 24px;
}

.is-mobile .detail-dynamic-image {
    width: 100%;
    height: 220px;
    margin-bottom: 16px;
}

.is-mobile .portal--horizontal-hero {
    width: 100%; 
    height: 25%; 
}
/* ==========================================
   MOBILE HEADER FIXES
========================================== */
.is-mobile .portal--vertical-header {
    width: 24px; 
    height: 60px;
    margin-right: 10px;
    /* CRITICAL: Prevents the text from squishing the portal */
    flex-shrink: 0; 
}

.is-mobile .header-title {
    font-size: 15px; /* Scaled down for mobile */
    flex-shrink: 1;  /* Allows the text to wrap/shrink if necessary */
    white-space: nowrap;
}

.is-mobile #HeaderExploreBtn,
.is-mobile #NavContact,
.is-mobile #BtnDownloadCV {
    min-width: 120px;  
    height: 35px;     
    margin-top: 2.5px;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 18px; /* Tighter gap between buttons */
    padding: 0;
}

/* Scales the text down to fit the smaller button height */
.is-mobile #HeaderExploreBtn .cyber-text,
.is-mobile #NavContact .cyber-text,
.is-mobile #BtnDownloadCV .cyber-text {
    font-size: 14px; 
}

/* Keeps the final button flush with the edge of the screen */
.is-mobile #BtnDownloadCV {
    margin-right: 0;
    margin-bottom: 24px;
}

/* --- MOBILE CV FIXES --- */
.is-mobile .timeline-box {
    padding-left: 20px;
    padding-right: 12px;
}

.is-mobile .timeline-header-row {
    flex-direction: column;
    align-items: flex-start;
}

.is-mobile .timeline-title {
    font-size: 20px;
    margin-bottom: 8px;
}

.is-mobile .timeline-date {
    font-size: 16px;
}

.is-mobile .timeline-text {
    font-size: 16px;
    margin-bottom: 12px;
}

.is-mobile .about-top-row {
    flex-direction: column;
    flex-wrap: nowrap;
    /* THE FIX: Override the desktop 'flex-start' so things stop sticking to the left */
    align-items: center; 
}
.is-mobile .profile-image-circle {
    margin-right: 0; /* Removes the 40px margin so the image centers perfectly */
    /* Width, height, and margin-bottom are inherited from the base class, 
       so it stays exactly 250x250 and keeps its bottom spacing! */
}
.is-mobile .about-paragraph {
    width: 100%;
    flex-basis: auto;
    flex-shrink: 0;
    white-space: normal;
}

/* Mobile override keeps them readable but prevents them from overflowing */
.is-mobile .skill-pill {
    font-size: 16px;
    padding: 8px 16px;
    margin-right: 10px;
    margin-bottom: 10px;
}
