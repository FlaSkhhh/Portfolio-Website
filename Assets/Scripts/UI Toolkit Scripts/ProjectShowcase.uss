Scroller {
    display: none;
}
.showcase-row {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    flex-direction: row;
    min-height: 380px;
    max-height: 480px;
    margin-bottom: 56px; /* Increased breathing room since the box is gone */
    
    /* STRIPPED OUT THE BOX */
    padding: 0; 
    background-color: rgba(20, 20, 20, 0.4); 
    border-width: 0;
    
    align-items: stretch;
    overflow: hidden;
    
    transition-property: border-color, translate, opacity;
    transition-duration: 0.2s, 0.6s, 0.8s;
    transition-timing-function: ease-out-back, ease-out;
}

/* CSS States toggled by the C# ScrollAnimationController */
.showcase-row--hidden {
    opacity: 0;
    translate: 0 60px 0;
}

.showcase-row--visible {
    opacity: 1;
    translate: 0 0 0;
}

.showcase-row.showcase-row--visible:hover {
    translate: 0 -4px 0;
    border-color: #00E5FF;
    transition-delay: 0.4s, 0.4s, 0s; 
}

.showcase-row--reverse {
    flex-direction: row-reverse;
}

.showcase-column {
    flex-direction: column;
    justify-content: center;
}

.showcase-column--image {
    /* Dynamic sizing instead of strict percentages */
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 400px; /* Ideal starting width */
    max-width: 650px;  /* Stops the image from getting too massive */
    
    padding-left: 5px;
    padding-right: 32px; /* Creates a strict 32px gap between image and text */
}

.showcase-column--info {
    /* Forces the text to dynamically fill whatever space the image leaves behind */
    flex-grow: 2; 
    
    padding-left: 5px;
    padding-right: 5px;
}

/* Flips the 32px gap to the left side when the layout alternates */
.showcase-row--reverse .showcase-column--image {
    padding-right: 5px;
    padding-left: 32px; 
}

.project-image {
    width: 100%;
    height: 100%;
    
    /* Transparent dark background */
    background-color: rgba(11, 12, 16, 0.4); 
    
    /* Top and Bottom lines only */
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 0;
    border-right-width: 0;
    
    /* Faded Cyan border */
    border-color: rgba(85, 234, 212, 0.2); 
    border-radius: 0;
    
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;

    transition-property: border-color;
    transition-duration: 0.3s;
}

.platform-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(11, 12, 16, 0.9);
    color: #00E5FF;
    border-color: rgba(0, 229, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
}
.showcase-row--reverse .platform-badge {
    right: auto;
    left: 16px; /* Moves the badge to the left of the image */
}

.tag-container {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.showcase-row--reverse .tag-container {
    justify-content: flex-end; /* Pushes the tech pills to the right */
}

.tech-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 4px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.project-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 14px;
}

.project-description {
    font-size: 16px;
    color: #8E95A5;
    white-space: normal;
    margin-bottom: 20px;
}
.showcase-row--reverse .project-title,
.showcase-row--reverse .project-description {
    -unity-text-align: upper-right; /* Anchors text to the right */
}

.button-row {
    flex-direction: row;
    align-items: center;
}
.showcase-row--reverse .button-row {
    justify-content: flex-end; /* Pushes buttons to the right */
}

.button-row Button {
    margin-right: 12px;
    flex-shrink: 0;
    white-space: nowrap;
}
.showcase-row--reverse .button-row Button {
    margin-right: 0;
    margin-left: 12px; /* Flips the button spacing */
}



/* ===== RESPONSIVE PORTRAIT QUERY ===== */



/* ===== RESPONSIVE PORTRAIT QUERY ===== */

/* 1. ROW SETUP */
.is-mobile .showcase-row,
.is-mobile .showcase-row--reverse {
    flex-direction: column;
    width: 100%;
    min-height: auto;
    max-height: 9999px; /* Kills the 480px desktop limit */
    padding: 20px;
    margin-bottom: 48px;
}

/* 2. THE IMAGE (80% Width) */
.is-mobile .showcase-column--image {
    width: 80%;
    flex-basis: auto; 
    flex-grow: 0;
    height: 160px;
    min-height: 160px;
    margin-bottom: 24px; /* Image height (160) + Margin (24) = 184px total block */
    padding: 0;
    flex-shrink: 0;
}

.is-mobile .showcase-row .showcase-column--image { align-self: flex-start; }
.is-mobile .showcase-row--reverse .showcase-column--image { align-self: flex-end; }

.is-mobile .project-image { width: 100%; height: 100%; }

/* 3. THE INFO CONTAINER */
.is-mobile .showcase-column--info {
    width: 100%;
    padding: 0;
}
/* ==========================================
   TEXT (Safely below the image)
========================================== */
.is-mobile .project-title,
.is-mobile .project-description {
    width: 100%;
    -unity-text-align: upper-left; 
}

.is-mobile .project-title { font-size: 24px; margin-bottom: 10px; }
.is-mobile .project-description { font-size: 15px; margin-bottom: 24px; }

/* ==========================================
   THE HASHTAG FIX (#C#, 3D, etc.)
========================================== */
.is-mobile .tag-container {
    position: absolute;
    
    /* 160px Image Height + 24px Image Margin = 184px */
    /* This yanks the tags completely out of the text block and pins them to the top! */
    top: -184px; 
    translate: 0 0; /* Clears any leftover translates */
    
    width: 20%;
    height: 160px; /* Matches the image height perfectly */
    
    flex-direction: column;
    justify-content: flex-start; 
    align-items: center;
}

/* Normal row: Tags in the right gap */
.is-mobile .showcase-row .tag-container { 
    right: 0; 
    left: auto; 
}

/* Reverse row: Tags in the left gap */
.is-mobile .showcase-row--reverse .tag-container { 
    left: 0; 
    right: auto; 
}

/* The actual #C# and 3D bubbles */
.is-mobile .tech-pill {
    font-size: 10px;
    padding: 6px 4px;
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 6px; 
    white-space: normal;
    -unity-text-align: middle-center;
    width: 90%; 
}

/* ==========================================
   BUTTONS (Strict 140x42 Size)
========================================== */
.is-mobile .button-row {
    flex-direction: row; 
    justify-content: flex-start;
    align-items: flex-start; 
    width: 100%;
    height: auto; 
    min-height: 42px; 
    flex-shrink: 0; 
    flex-wrap: wrap; 
}

.is-mobile .button-row Button,
.is-mobile .cyber-btn {
    position: relative;
    
    /* LOCKED WIDTH */
    width: 140px; 
    min-width: 140px; 
    max-width: 140px; 
    
    /* LOCKED HEIGHT */
    height: 42px;
    min-height: 42px; 
    max-height: 42px; 
    
    flex-shrink: 0; 
    margin: 0 12px 12px 0; 
    padding: 0;
}

/* Text scale adjustment to fit perfectly inside 42px */
.is-mobile .cyber-btn .cyber-text {
    font-size: 13px; 
}

.is-mobile .showcase-row--reverse .button-row Button,
.is-mobile .showcase-row--reverse .cyber-btn {
    margin: 0 12px 12px 0;
}