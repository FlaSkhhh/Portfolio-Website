.showcase-row {
    width: 100%;
    max-width: 2712px;
    align-self: center;
    flex-direction: row;
    min-height: 380px;
    max-height: 480px;
    margin-bottom: 40px;
    padding: 28px;
    align-items: stretch;

    background-color: #14161F;
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 14px;
    overflow: hidden;
    
    /* Animation settings */
    transition-property: border-color, translate, opacity;
    transition-duration: 0.2s, 0.6s, 0.8s;
    transition-timing-function: ease-in-out, ease-out-back, ease-out;
}

/* CSS States toggled by the C# ScrollAnimationController */
.showcase-row--hidden {
    opacity: 0;
    translate: 0 60px 0;
}

.showcase-row--visible {
    opacity: 1;
    translate: 0 0 0;
}

.showcase-row.showcase-row--visible:hover {
    border-color: rgba(85, 234, 212, 0.5);
    translate: 0 -4px 0;
    /* 1st value: border-color delay (0.4s) */
    /* 2nd value: translate delay (0.4s) */
    /* 3rd value: opacity delay (0s) - Allows C# fade-in to bypass the hover delay */
    transition-delay: 0.4s, 0.4s, 0s; 
}

.showcase-row--reverse {
    flex-direction: row-reverse;
}

.showcase-column {
    flex-direction: column;
    justify-content: center;
}

.showcase-column--image {
    width: 40%;
    max-width: 720px;
    padding-left: 16px;
    padding-right: 16px;
}

.showcase-column--info {
    width: 60%;
    max-width: 720px;
    padding-left: 24px;
    padding-right: 24px;
}

.showcase-row--reverse .showcase-column--info {
    align-items: flex-end; /* Anchors containers to the right */
}

.project-image {
    width: 100%;
    height: 100%;
    background-color: #0B0C10;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    position: relative;
    overflow: hidden;
    -unity-background-scale-mode: scale-and-crop;
}

.platform-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    background-color: rgba(11, 12, 16, 0.9);
    color: #00E5FF;
    border-color: rgba(0, 229, 255, 0.3);
    border-width: 1px;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
}
.showcase-row--reverse .platform-badge {
    right: auto;
    left: 16px; /* Moves the badge to the left of the image */
}

.tag-container {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
}
.showcase-row--reverse .tag-container {
    justify-content: flex-end; /* Pushes the tech pills to the right */
}

.tech-pill {
    background-color: rgba(0, 229, 255, 0.12);
    color: #00E5FF;
    padding: 6px 12px;
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.25);
    border-radius: 4px;
    margin-right: 8px;
    margin-bottom: 8px;
}

.project-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #FFFFFF;
    white-space: normal;
    margin-bottom: 14px;
}

.project-description {
    font-size: 16px;
    color: #8E95A5;
    white-space: normal;
    margin-bottom: 20px;
}
.showcase-row--reverse .project-title,
.showcase-row--reverse .project-description {
    -unity-text-align: upper-right; /* Anchors text to the right */
}

.button-row {
    flex-direction: row;
    align-items: center;
}
.showcase-row--reverse .button-row {
    justify-content: flex-end; /* Pushes buttons to the right */
}

.button-row Button {
    margin-right: 12px;
    flex-shrink: 0;
    white-space: nowrap;
}
.showcase-row--reverse .button-row Button {
    margin-right: 0;
    margin-left: 12px; /* Flips the button spacing */
}
/* ===== RESPONSIVE PORTRAIT QUERY ===== */
@media (max-width: 1400px) {
    .showcase-row {
        flex-direction: column;
        width: 100%;
        min-height: auto;
        max-height: none; /* CRITICAL: Allows vertical stacking without chopping off text */
        padding: 20px;
        margin-bottom: 28px;
        align-items: stretch;
    }

    .showcase-row--reverse {
        flex-direction: column;
    }

    .showcase-column--image {
        width: 100%;
        max-width: none; /* Reset ceiling */
        min-height: 60vw; /* Scales the image naturally with phone width */
        height: 60vw;
        max-height: none; /* Reset ceiling */
        margin-bottom: 24px;
        padding-left: 0;
        padding-right: 0;
        flex-shrink: 0;
    }

    .project-image {
        width: 100%;
        height: 100%;
        min-height: 60vw;
        max-height: none; /* Reset ceiling */
    }

    .showcase-column--info {
        width: 100%;
        max-width: none; /* Reset ceiling */
        padding-left: 0;
        padding-right: 0;
    }

    .project-title {
        font-size: 28px;
        width: 100%;
    }

    .project-description {
        font-size: 17px;
        width: 100%;
    }

    .button-row {
        flex-direction: column;
        width: 100%;
    }

    .btn-primary,
    .btn-secondary {
        width: 100%;
        margin-right: 0;
        margin-bottom: 12px;
    }

    /* Reset reverse alignment back to normal for stacked mobile cards */
    .showcase-row--reverse .showcase-column--info {
        align-items: flex-start;
    }

    .showcase-row--reverse .project-title,
    .showcase-row--reverse .project-description {
        -unity-text-align: upper-left;
    }

    .showcase-row--reverse .tag-container,
    .showcase-row--reverse .button-row {
        justify-content: flex-start;
    }

    .showcase-row--reverse .button-row Button {
        margin-left: 0;
        margin-right: 12px;
    }
    
    .showcase-row--reverse .platform-badge {
        left: auto;
        right: 16px;
    }
}